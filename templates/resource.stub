<?php

namespace App\Http\Resources\Client;

use App\Models\{{EntityName}};
use Illuminate\Http\Request;
use Illuminate\Http\Resources\Json\JsonResource;

// Resource — the client contract: an explicit whitelist of fields with explicit casts.
// Extra columns are cut off earlier, in the repository select. Never load relations here (whenLoaded only) — no queries.
// Never expose internal/sensitive fields (remote_code, tokens, timestamps not needed by the client).
// DECISION: if the admin panel needs another shape (e.g. the full translations array) —
// a separate class in App\Http\Resources\Admin (a proposal, to confirm with the author).

/**
 * @mixin {{EntityName}}
 *
 * @property string $label
 */
class {{EntityName}}Resource extends JsonResource
{
    /**
     * Transform the resource into an array.
     *
     * @return array<string, mixed>
     */
    public function toArray(Request $request): array
    {
        return [
            'id' => $this->id,
            '{{parent_id}}' => $this->{{parent_id}},
            'label' => $this->label,
            // 'price' => (float) $this->price,
            // 'is_active' => (bool) $this->is_active,
            // 'nullable_price' => $this->price !== null ? (float) $this->price : null,
            // '{{parentName}}' => {{ParentName}}Resource::make($this->whenLoaded('{{parentName}}')),
        ];
    }
}
