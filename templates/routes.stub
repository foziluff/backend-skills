// routes/api.php — add the use and the routes to the right group.
use App\Http\Controllers\{{EntityName}}Controller;

// DECISION: access group
//   public reads for the app      → top of the file, outside groups, with ->middleware('throttle:…') if expensive
//   user actions                  → inside Route::middleware(['auth:sanctum'])
//   management (admin CRUD)       → inside Route::middleware('role:'.Role::ADMIN->value)
// Never add dev/debug routes.

Route::middleware(['auth:sanctum'])->group(function (): void {
    Route::middleware('role:'.Role::ADMIN->value)->group(function (): void {
        Route::get('{{entity-names}}', [{{EntityName}}Controller::class, 'index']);
        Route::get('{{entity-names}}/{id}', [{{EntityName}}Controller::class, 'show'])->whereNumber('id');
        Route::post('{{entity-names}}', [{{EntityName}}Controller::class, 'store']);
        Route::patch('{{entity-names}}/{id}', [{{EntityName}}Controller::class, 'update'])->whereNumber('id');
        Route::delete('{{entity-names}}/{id}', [{{EntityName}}Controller::class, 'destroy'])->whereNumber('id');

        // An action on a resource — POST with a verb:
        // Route::post('{{entity-names}}/{id}/{{verb}}', [{{EntityName}}Controller::class, '{{verb}}'])->whereNumber('id');
    });
});

// A sensitive public route — with throttle:
// Route::post('send-code', [UserController::class, 'sendCode'])->middleware('throttle:1,1');
