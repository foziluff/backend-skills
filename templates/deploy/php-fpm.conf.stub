[global]
error_log = /proc/self/fd/2

[www]
listen = 9000
; DECISION: size from RAM (~30–60 MB per worker) and keep max_children well below MySQL --max-connections (40).
pm = dynamic
pm.max_children = 12
pm.start_servers = 3
pm.min_spare_servers = 2
pm.max_spare_servers = 6
pm.max_requests = 1000
access.log = /dev/null
catch_workers_output = yes
decorate_workers_output = no
