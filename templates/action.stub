<?php

namespace App\Actions;

use App\Repositories\{{EntityName}}Repository;
use Illuminate\Support\Facades\Log;
use Throwable;

// Action — an operation called by ≥2 services/entry points (HTTP, scheduler, OCPP).
// The only public method is handle. Data and external calls only through repositories.
// DECISION: a utility without dependencies → `public static function handle(...)` and no constructor.
readonly class {{Verb}}{{EntityName}}Action
{
    public function __construct(
        private {{EntityName}}Repository ${{entityName}}Repository,
    ) {}

    public function handle(int $id /* , ... */): mixed
    {
        try {
            return transaction(function () use ($id) {
                // 1. fetch with lockForUpdate and check the state → domain exception (idempotency)
                // 2. calculations (formulas are static model methods), round(..., 2) for money
                // 3. writes through repositories; a denormalized value changes here, together with its source of truth
                // 4. side effects through gateway repositories (inside defer, with snapshot data)
            });
        } catch (Throwable $e) {
            // DECISION: log-and-rethrow only for money/charging operations (the charging channel); ids only, no personal data
            Log::channel('charging')->error('Failed to {{verb}} {{entity_name}}: '.$e->getMessage(), [
                '{{entity_name}}_id' => $id,
                'exception' => get_class($e),
            ]);
            throw $e;
        }
    }
}
