<?php

namespace App\Http\Requests\{{EntityName}};

use Illuminate\Foundation\Http\FormRequest;

// app/Http/Requests/{{EntityName}}/Store{{EntityName}}Request.php
//
// DECISION — stop policy:
//   • a multi-field FORM (admin store/update, profile) → WITHOUT $stopOnFirstFailure and WITHOUT 'bail' (as below):
//     the frontend gets all errors at once;
//   • a filter / query parameters / a 1–2-field action → add
//         protected $stopOnFirstFailure = true;
//     and 'bail' as the first element of every rule (see request-index.stub).
//
// No exists:/unique: — no DB queries outside repositories; the service checks existence/uniqueness inside transaction() with lockForUpdate.
// No authorize() — access is declared by route middleware.
// rules() never reads the request/route/user (the Swagger generator calls it without a request).
// Every field: an explicit type token + bounds. NEVER privileged fields (role, balance…) in a user-facing request.
class Store{{EntityName}}Request extends FormRequest
{
    public function rules(): array
    {
        return [
            '{{parent_id}}' => ['required', 'integer', 'min:1', 'max:999999999999999'],
            'label' => ['required', 'string', 'min:1', 'max:255'],
            // 'price' => ['required', 'numeric', 'min:0.01', 'max:99999999.99'],
            // 'status' => ['required', new Enum({{EntityName}}Status::class)],
            // 'opening_time' => ['required', 'date_format:H:i'],
            // Translations:
            // 'translations' => ['required', 'array', 'min:1', 'max:1000'],
            // 'translations.*.language_code' => ['required', 'distinct', 'string', 'size:2'],
            // 'translations.*.name' => ['required', 'string', 'min:1', 'max:255'],
        ];
    }
}
