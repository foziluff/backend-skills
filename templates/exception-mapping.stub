// 1) import at the top of the file (alphabetical order):
use App\Exceptions\{{EntityName}}NotFoundException;
use App\Exceptions\{{EntityName}}LimitReachedException;

// 2) lines inside match (true) in mapExceptionToResponseData() — exactly this one-line form (the Swagger generator parses it):
//    DECISION: status from the table in references/error-handling.md
//      missing/foreign → 404 · business rule/limit/state → 422 · conflict with state → 409
//      no money → 402 · physical precondition → 412
$e instanceof {{EntityName}}NotFoundException => [Response::HTTP_NOT_FOUND, __('all.{{entity_name}}_not_found')],
$e instanceof {{EntityName}}LimitReachedException => [Response::HTTP_UNPROCESSABLE_ENTITY, __('all.{{entity_name}}_limit_reached')],

