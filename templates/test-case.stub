<?php

namespace Tests;

use Illuminate\Foundation\Testing\RefreshDatabase;
use Illuminate\Foundation\Testing\TestCase as BaseTestCase;
use Illuminate\Support\Facades\Http;

// tests/TestCase.php
abstract class TestCase extends BaseTestCase
{
    use RefreshDatabase;   // DECISION: DatabaseTruncation for FULLTEXT search tests (InnoDB indexes FULLTEXT only on commit)

    #[\Override]
    protected function setUp(): void
    {
        parent::setUp();

        // No test reaches the network: WS gateway, OCPP commands, FCM, SMS — all go through Http.
        Http::preventStrayRequests();
        Http::fake([
            '*/broadcast' => Http::response([]),
            '*/command/*' => Http::response(['status' => 'Accepted']),
        ]);
    }
}
