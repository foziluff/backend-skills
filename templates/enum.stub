<?php

namespace App\Enums;

// app/Enums/{{EntityName}}{{Aspect}}.php  (e.g. TariffStatus, TariffType)
//
// The fixed set of values lives HERE, not in the DB:
//   • migration:  $table->string('{{aspect}}')                    — NOT $table->enum(...)
//   • model:      '{{aspect}}' => {{EntityName}}{{Aspect}}::class    in casts()
//   • request:    new Enum({{EntityName}}{{Aspect}}::class)
//   • code:       {{EntityName}}{{Aspect}}::ACTIVE, compared by ->value — never a raw string 'active'
//   • untrusted:  {{EntityName}}{{Aspect}}::tryFrom($raw) → null → explicit branch (never ::from() on input)
// A new value = a new case, no migration.
enum {{EntityName}}{{Aspect}}: string
{
    case ACTIVE = 'active';
    case ARCHIVED = 'archived';

    // DECISION: groups of values and rules about values are enum methods, not string arrays in services
    /**
     * @return array<int, self>
     */
    public static function visibleStatuses(): array
    {
        return [
            self::ACTIVE,
        ];
    }

    public function isFinal(): bool
    {
        return $this->value === self::ARCHIVED->value;
    }
}
