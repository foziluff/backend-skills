<?php

namespace Tests\Unit\Models;

use App\Models\{{EntityName}};
use PHPUnit\Framework\Attributes\DataProvider;
use PHPUnit\Framework\TestCase;

// Unit — only pure domain math of a model or enum rules (no DB, no Laravel container).
// Project examples: ChargingSession::calculateCost, calculateIntervalWatts, normalizeSoc.
class {{EntityName}}Test extends TestCase
{
    /**
     * @return array<string, array{int, int, int}>
     */
    public static function costProvider(): array
    {
        return [
            'one kWh' => [1000, 150, 150],
            'rounds once to the minor unit' => [333, 150, 50],
            'exact half on an odd quotient → up to even' => [1010, 150, 152],
            'exact half on an even quotient → stays even' => [1030, 150, 154],
            'zero' => [0, 150, 0],
        ];
    }

    #[DataProvider('costProvider')]
    public function test_calculate_cost_returns_amount_in_minor_units(int $watts, int $pricePerKw, int $expected): void
    {
        $this->assertSame($expected, {{EntityName}}::calculateCost($watts, $pricePerKw));
    }
}
