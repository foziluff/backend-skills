<?php

namespace App\Models;

// DECISION: if there are translatable fields — use App\Traits\HasTranslations; and add it to the trait list
use Illuminate\Database\Eloquent\Factories\HasFactory;
use Illuminate\Database\Eloquent\Model;
use Illuminate\Database\Eloquent\Relations\BelongsTo;
use Illuminate\Database\Eloquent\SoftDeletes;

/**
 * @property int $id
 * @property int ${{parent_id}}
 * @property string $label
 * @property {{ParentName}}|null ${{parentName}}
 */
class {{EntityName}} extends Model
{
    use HasFactory, SoftDeletes;

    // Business limits and parameters are typed constants — no magic numbers in services
    public const int MAX_PER_{{PARENT_NAME}} = 100;

    // Explicit whitelist. Privileged fields (role, balance…) may be fillable, but must never appear in a user-facing FormRequest.
    protected $fillable = [
        '{{parent_id}}',
        'label',
    ];

    // DECISION: translatable fields (if HasTranslations is used)
    // protected array $translatable = [
    //     'name',
    // ];

    // Only what the client really needs. Translatable fields are listed here too.
    public const array DEFAULT_SELECT_COLUMNS = [
        'id',
        '{{parent_id}}',
        'label',
    ];

    // Timestamps, deleted_at and every internal/sensitive field.
    protected $hidden = [
        'created_at',
        'updated_at',
        'deleted_at',
    ];

    #[\Override]
    protected function casts(): array
    {
        return [
            '{{parent_id}}' => 'integer',
            // 'price' => 'integer',   // money: minor units (PHPDoc @property int $price)
            // 'is_active' => 'boolean',
            // 'status' => {{EntityName}}Status::class,   // every fixed-set column is cast to its enum
            // 'started_at' => 'datetime',
        ];
    }

    public function {{parentName}}(): BelongsTo
    {
        return $this->belongsTo({{ParentName}}::class);
    }

    // DECISION: domain math is public static, so one formula is shared by the service, the Action and accessors.
    // Accessors compute only from loaded data — no queries, no I/O.
    // Money is int in minor units: + and × a quantity are exact; a share is rounded once by Money::share (half to even).
    // public static function calculateCost(int $watts, int $pricePerKw): int
    // {
    //     return Money::share($pricePerKw, $watts, 1000);   // a per-kWh rate, watts are watt-hours
    // }
}
